def replacezero(arr):
    left=0
    maxlen=0
    count=0
    for right in range(len(arr)):

        if arr[right]==0:
            count+=1

        while count>2:
            if arr[left]==0:
              count+=1
            left+=1
        
        maxlen=max(maxlen,right-left+1)
        print(maxlen)

    return maxlen

