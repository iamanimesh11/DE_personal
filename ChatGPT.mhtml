s-string">"R2"</span>, <span class=3D"hljs-string">"R3"</span>]  <span clas=
s=3D"hljs-comment"># Simulating new models detected from API</span>

<span class=3D"hljs-keyword">for</span> model <span class=3D"hljs-keyword">=
in</span> new_models:
    create_model_table(model)

<span class=3D"hljs-comment"># Close connection</span>
cur.close()
conn.close()
