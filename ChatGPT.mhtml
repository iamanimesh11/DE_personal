    port=3D<span class=3D"hljs-string">"your_port"</span>
)
cur =3D conn.cursor()

<span class=3D"hljs-comment"># Function to create a new table for a model i=
f it doesn't exist</span>
<span class=3D"hljs-keyword">def</span> <span class=3D"hljs-title function_=
">create_model_table</span>(<span class=3D"hljs-params">model_name</span>):
    table_name =3D <span class=3D"hljs-string">f"refrigerator_model_<span c=
lass=3D"hljs-subst">{model_name.lower()}</span>"</span>
   =20
    <span class=3D"hljs-comment"># Check if table already exists</span>
    cur.execute(<span class=3D"hljs-string">f"""
        SELECT COUNT(*) FROM information_schema.tables
        WHERE table_schema =3D 'devices' AND table_name =3D '<span class=3D=
"hljs-subst">{table_name}</span>'
    """</span>)
    exists =3D cur.fetchone()[<span class=3D"hljs-number">0</span>]

    <span class=3D"hljs-keyword">if</span> exists =3D=3D <span class=3D"hlj=
s-number">0</span>:
        <span class=3D"hljs-comment"># Create table dynamically</span>
        cur.execute(<span class=3D"hljs-string">f"""
            CREATE TABLE devices.<span class=3D"hljs-subst">{table_name}</s=
pan> (
                device_id VARCHAR(255) PRIMARY KEY,
                device_type VARCHAR(50) NOT NULL,
                model_name VARCHAR(255) NOT NULL,
                alias VARCHAR(255),
                reportable BOOLEAN DEFAULT TRUE,
                created_at TIMESTAMP DEFAULT NOW(),
                updated_at TIMESTAMP DEFAULT NOW() ON UPDATE NOW()
            )
        """</span>)
        conn.commit()
        <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-stri=
ng">f"=E2=9C=85 Table <span class=3D"hljs-subst">{table_name}</span> create=
d successfully!"</span>)
    <span class=3D"hljs-keyword">else</span>:
        <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-stri=
ng">f"=E2=9A=A1 Table <span class=3D"hljs-subst">{table_name}</span> alread=
y exists."</span>)

<span class=3D"hljs-comment"># Example usage when fetching data from API</s=
pan>
