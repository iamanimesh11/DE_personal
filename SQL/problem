with funnel as (
select 'visit_homepage' as step ,count(distinct user_id) as users 
from user_events where event_type='visit_homepage'
union all
select 'view_product' as step ,count(distinct user_id) as users 
from user_events where event_type='view_product'
union all
select 'add_to_cart' as step ,count(distinct user_id) as users 
from user_events where event_type='add_to_cart'
union all
select 'purchase' as step ,count(distinct user_id) as users 
from user_events where event_type='purchase'
)
,
prev as (
select step,users,
lag(users) over (order by field(step,'visit_homepage','visit_product','add_to_cart','purchase'))
as prev_users
from funnel
)

select step,users,prev_users,round(users*100.0/coalesce(prev_users,users),2) as conversion_rate
from prev
order by 
field(step,'visit_homepage','visit_product','add_to_cart','purchase')












