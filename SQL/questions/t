<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Streaming Platform Sample Database</title>

<style>
:root{
    --bg:#0f172a;
    --card:#1e293b;
    --card-hover:#273549;
    --border:#334155;
    --text:#f8fafc;
    --muted:#94a3b8;
    --accent:#38bdf8;
    --success:#22c55e;
    --danger:#ef4444;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:var(--bg);
    color:var(--text);
    font-family:Inter, Segoe UI, Arial, sans-serif;
    padding:30px;
}

h1{
    text-align:center;
    margin-bottom:30px;
    color:var(--accent);
}

.table-section{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:16px;
    padding:20px;
    margin-bottom:30px;
    box-shadow:0 10px 25px rgba(0,0,0,.25);
}

.table-section h2{
    margin-bottom:15px;
    color:var(--accent);
}

.table-wrapper{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:800px;
}

th{
    background:#0f2138;
    color:var(--accent);
    text-align:left;
    padding:12px;
    border-bottom:2px solid var(--border);
}

td{
    padding:12px;
    border-bottom:1px solid var(--border);
}

tr:hover{
    background:var(--card-hover);
}

.badge-premium{
    background:#15803d;
    color:white;
    padding:4px 8px;
    border-radius:20px;
    font-size:12px;
}

.badge-basic{
    background:#475569;
    color:white;
    padding:4px 8px;
    border-radius:20px;
    font-size:12px;
}

.completed{
    color:var(--success);
    font-weight:bold;
}

.not-completed{
    color:var(--danger);
    font-weight:bold;
}

.rating{
    color:#fbbf24;
    font-weight:bold;
}

.subtitle{
    text-align:center;
    color:var(--muted);
    margin-bottom:30px;
}
</style>
</head>
<body>

<h1>📺 Streaming Platform Database</h1>
