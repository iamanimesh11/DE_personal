-- ==========================================
-- CREATE TABLES
-- ==========================================

CREATE TABLE users (
    user_id INT PRIMARY KEY,
    name VARCHAR(100),
    country VARCHAR(50),
    plan VARCHAR(20),
    joined_date DATE
);

CREATE TABLE content (
    content_id VARCHAR(10) PRIMARY KEY,
    title VARCHAR(255),
    genre VARCHAR(50),
    release_date DATE,
    duration_min INT,
    language VARCHAR(50)
);

CREATE TABLE watch_history (
    watch_id VARCHAR(10) PRIMARY KEY,
    user_id INT,
    content_id VARCHAR(10),
    watched_at TIMESTAMP,
    watch_duration_min INT,
    completed BOOLEAN,
    FOREIGN KEY (user_id) REFERENCES users(user_id),
    FOREIGN KEY (content_id) REFERENCES content(content_id)
);

CREATE TABLE ratings (
    rating_id VARCHAR(10) PRIMARY KEY,
    user_id INT,
    content_id VARCHAR(10),
    score INT,
    rated_at DATE,
    FOREIGN KEY (user_id) REFERENCES users(user_id),
    FOREIGN KEY (content_id) REFERENCES content(content_id)
);

