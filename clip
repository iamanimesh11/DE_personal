CREATE TABLE trips (
    trip_id INT PRIMARY KEY,
    driver_id INT,
    rider_id INT,
    start_time DATETIME,
    end_time DATETIME,
    status VARCHAR(20),
    fare DECIMAL(10, 2),
    distance_km DECIMAL(5, 2),
    FOREIGN KEY (driver_id) REFERENCES drivers(driver_id),
    FOREIGN KEY (rider_id) REFERENCES riders(rider_id)
);

