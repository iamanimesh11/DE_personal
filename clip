@echo off
setlocal

REM 🔐 Replace with your token
set TOKEN=YOUR_ACCESS_TOKEN

REM 📁 Output folder
if not exist output mkdir output

REM 📄 Input file
set INPUT_FILE=containers.txt

for /f %%c in (%INPUT_FILE%) do (
    echo Fetching data for %%c...

    curl -X POST "https://www.ulipstaging.dpiit.gov.in/ulip/v1.0.0/LDB/01" ^
    -H "Authorization: Bearer %TOKEN%" ^
    -H "Content-Type: application/json" ^
    -H "Accept: application/json" ^
    -d "{\"containerNumber\":\"%%c\"}" ^
    -o "output\%%c.json"

    echo Saved: output\%%c.json

    REM ⏱️ Wait 5 seconds
    timeout /t 5 >nul
)

echo.
echo ✅ All container data fetched!
pause
